# Puerto HTTP (Cloud Run lo inyecta como 8080).
PORT=8080

# Origen(es) permitido(s) por CORS. "*" o lista separada por comas.
ALLOWED_ORIGIN=http://localhost:3000

# URLs de los servicios internos (en local, los puertos de `npm run dev`).
BOARD_SERVICE_URL=http://localhost:8081
RATELIMIT_SERVICE_URL=http://localhost:8082

# Clave compartida entre microservicios (cabecera x-internal-key).
INTERNAL_API_KEY=dev-internal-key

# grpc (por defecto, HTTP/2 h2c) | connect (HTTP/1.1, p. ej. Render).
# INTERNAL_PROTOCOL=grpc
